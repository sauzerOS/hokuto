#!/bin/bash
#
# hokuto-builder: run hokuto in a systemd-nspawn container instead of on the
# host, typically for `hokuto bump --auto --build`. Build dependencies and
# base-devel get installed into the container, not the host system.
#
#   hokuto-builder create          create the container (once)
#   hokuto-builder bump [-y] [-jN] hokuto bump --auto --build, interactive;
#                                  -y bumps and builds everything unattended;
#                                  everything is bumped first, then the
#                                  successful bumps are built together, N at a
#                                  time (default 4)
#   hokuto-builder build <pkg...>  build as bump --build does, then upload --sync;
#                                  --no-upload skips the upload, other options
#                                  go to hokuto build
#   hokuto-builder rebuild [-y] [-jN]
#                                  build and upload recipes whose version or
#                                  revision is ahead of the mirror (after an
#                                  ABI change bump bumped them); the container
#                                  is first updated from the mirror so they
#                                  link against the new libraries; -y builds,
#                                  without asking, those published before
#   hokuto-builder cross-sync [-system] [-y] [-jN]
#                                  hokuto cross-sync, then upload --sync;
#                                  -y builds every missing package;
#                                  --no-upload skips the upload
#   hokuto-builder cycle           one unattended round: bump -y, rebuild -y,
#                                  --generic rebuild -y with CYCLE_GENERIC=1,
#                                  cross-sync -system -y, cross-sync -y; before
#                                  each and at the end it removes what failed
#                                  builds left in the build tmpdirs; results go
#                                  to /var/log/hokuto-builder/runs.log
#                                  hokuto-builder.timer runs it unattended,
#                                  15 minutes after the previous round ends:
#                                  systemctl enable --now hokuto-builder.timer
#   hokuto-builder blacklist [list | remove [-arch <arch>] <pkg>... | clear]
#                                  the packages unattended builds skip after
#                                  their build failed, until their version or
#                                  revision changes; remove retries them
#   hokuto-builder nobuild [list | [add] [-cross] <pkg>... |
#                           remove [-cross|-native] <pkg>... | clear [-cross|-native]]
#                                  packages never built here until removed:
#                                  bump bumps but does not build them and
#                                  rebuild skips them; -cross entries are
#                                  skipped by cross-sync (-system)
#   hokuto-builder python-rebuild [--status | --list | --check [-jN] |
#                                  --confirm [--force] | --cancel]
#                                  a new python minor release (3.14 -> 3.15)
#                                  is held: a build of it bumps nothing and
#                                  uploads nothing, and the website shows a
#                                  notice; --check builds the new python and
#                                  every package that needs the rebuild against
#                                  it, in a throwaway overlay of the container,
#                                  and reports which fail; --confirm, once all
#                                  of them built, bumps them and releases
#                                  python for the next rebuild; --cancel drops
#                                  the hold (after reverting the python bump)
#   hokuto-builder run <cmd...>    run any command in the container
#   hokuto-builder shell           interactive shell in the container
#   hokuto-builder update          update the container's own packages
#   hokuto-builder destroy         delete the container
#
#   hokuto-builder --generic <command>
#                                  the same in a second container whose own
#                                  packages are all the generic variant, where
#                                  hokuto builds generic packages
#                                  (HOKUTO_GENERIC=1); bump and cross-sync stay
#                                  in the optimized container
#
# Commands run as the invoking user (same name and uid as on the host), with
# passwordless sudo inside the container. Shared with the host:
#
#   /repo                        recipes; bump commits and pushes from here
#   /var/cache/hokuto            binary cache (and the sources mount below it)
#   /var/tmp/hokuto              TMPDIR, on the host's zram disk
#   /var/tmpdir/hokuto           TMPDIR2, disk-backed, for "noram" builds
#   /etc/hokuto/hokuto.conf, hokuto.lock, hokuto.prefer, keys/, mirror-auth
#                                config, mirror credentials and login, version
#                                locks, alternative dependency choices and the
#                                signing key
#   /usr/local/bin/hokuto        the host's hokuto, so both run the same version;
#                                it comes first in PATH. The container's own
#                                hokuto package (/usr/bin/hokuto, hokuto.update,
#                                .rebuild, .pkgset) stays updatable; hokuto.conf
#                                and hokuto.prefer are copied in on every run.
#   ~/.gitconfig, ~/.git-credentials   git identity and push credentials
#   /var/db/hokuto/bump-ignore.json, build-ignore.json   the bump and rebuild
#                                blacklists
#   /var/db/hokuto/nobuild.json  the no-build list, shared by both containers
#   the sauzerOS.github.io checkout    build status and logs (bump --build)
#
# The container location is asked for by 'create' and saved in
# /etc/hokuto-builder.conf for the other commands.
#
# The container's cgroup runs at idle CPU weight, so builds only get the CPU
# time the host's own work leaves. Idle weight alone still slowed the host
# (builds share its cores' hyperthreads and lower their boost clocks), so
# builds are also capped at 80% of the threads, and their memory is
# throttled above half the RAM, before the host's own memory is swapped out.
# /etc/hokuto-builder.conf can change these:
#
#   CPU_WEIGHT=idle              systemd CPUWeight= (1-10000 or idle); an
#                                empty value removes the limit
#   CPU_QUOTA=                   systemd CPUQuota=, 100% per thread (1600%
#                                is 16 threads); unset, 80% of the threads;
#                                empty removes the cap
#   MEMORY_HIGH=50%              systemd MemoryHigh= (bytes, K/M/G or a
#                                percentage of RAM); empty removes the limit
#   CYCLE_JOBS=4                 packages cycle builds at once
#   CYCLE_GENERIC=0              1: cycle also runs --generic rebuild -y, in
#                                the generic container, which must exist
#
# The generic container shares the same directories, except that it keeps its
# own rebuild blacklist (build-ignore-generic.json) and does not publish build
# status to the website, whose table has one entry per package. Both share the
# binary cache, so only one container runs a command at a time; a second one
# waits (interactive shells do not).
#
# Settings (environment):
#   HOKUTO_BUILDER_ROOT          container root, overrides the saved location
#   HOKUTO_BUILDER_GENERIC_ROOT  the same for the generic container
#   HOKUTO_BUILDER_NAME          machine name (default hokuto-builder; the
#                                generic container adds -generic)
#   HOKUTO_BUILDER_USER          the build user when started as root without
#                                sudo (the service); otherwise BUILD_USER in
#                                /etc/hokuto-builder.conf, saved by 'create',
#                                or the owner of the container's state

set -euo pipefail

CONFIG_FILE=/etc/hokuto-builder.conf
DEFAULT_ROOTFS=/var/lib/hokuto-builder
MACHINE=${HOKUTO_BUILDER_NAME:-hokuto-builder}

# sauzeros and base-devel are metapackages (/repo/sauzeros/.hokuto).
BASE_PACKAGES=(sauzeros base-devel git git-lfs sudo ca-certificates curl wget rsync less)

# The build tmpdirs (TMPDIR and TMPDIR2 in hokuto.conf).
TMP_DIRS=(/var/tmp/hokuto /var/tmpdir/hokuto)
# Directories shared read-write with the host.
SHARED_DIRS=(/repo /var/cache/hokuto "${TMP_DIRS[@]}")
SOURCES_MOUNT=/var/cache/hokuto/sources
SOURCES_UNIT=var-cache-hokuto-sources.mount
# The auto-bump blacklist is state, not configuration: keep one copy.
BUMP_IGNORE=/var/db/hokuto/bump-ignore.json
# Likewise the blacklist of update --build-missing-binaries (rebuild).
BUILD_IGNORE=/var/db/hokuto/build-ignore.json
# The no-build list is policy: one copy for both containers and the host.
NO_BUILD=/var/db/hokuto/nobuild.json
# hokuto publishes build status and logs to this checkout (HOKUTO_WEBSITE_REPO
# in hokuto.conf, same default as hokuto).
DEFAULT_WEBSITE_REPO=/home/dbz/Documents/sauzerOS.github.io

die() {
    # Plain under systemd: the journal shows escape codes as they are.
    if [ -t 2 ]; then
        printf '\033[0;31merror:\033[0m %s\n' "$*" >&2
    else
        printf 'error: %s\n' "$*" >&2
    fi
    exit 1
}
# hokuto's colors: a #FFEB3B arrow and #1976D2 text, on a terminal only.
info() {
    if [ -t 1 ]; then
        printf '\033[38;2;255;235;59m->\033[0m \033[38;2;25;118;210m%s\033[0m\n' "$*"
    else
        printf -- '-> %s\n' "$*"
    fi
}

usage() {
    # The command list: the header up to the paragraph after it.
    awk 'NR >= 3 && /^# Commands run as/ { exit } NR >= 3' "$(readlink -f "$0")" |
        sed '$d' | sed 's/^# \{0,1\}//'
    exit "${1:-0}"
}

ORIG_ARGS=("$@")
VARIANT=optimized
if [ "${1:-}" = --generic ]; then
    VARIANT=generic
    shift
fi

case "${1:-}" in
    create | bump | build | rebuild | cross-sync | cycle | blacklist | nobuild | python-rebuild | run | shell | update | destroy) ;;
    -h | --help | help) usage ;;
    *) usage 1 ;;
esac

if [ "$VARIANT" = generic ]; then
    case "$1" in
        bump) die "bump runs in the optimized container; build the generic packages afterwards with 'hokuto-builder --generic rebuild'" ;;
        cross-sync) die "cross-sync runs in the optimized container" ;;
        cycle) die "cycle runs in the optimized container" ;;
        python-rebuild) die "python-rebuild runs in the optimized container" ;;
    esac
fi

if [ "$EUID" -ne 0 ]; then
    exec sudo --preserve-env=HOKUTO_BUILDER_ROOT,HOKUTO_BUILDER_GENERIC_ROOT,HOKUTO_BUILDER_NAME \
        "$(readlink -f "$0")" "${ORIG_ARGS[@]}"
fi

# Where the rebuild blacklist lives inside the container, whichever host file
# backs it.
CONTAINER_BUILD_IGNORE=/var/db/hokuto/build-ignore.json
ROOTFS_KEY=ROOTFS
ROOTFS_OVERRIDE=${HOKUTO_BUILDER_ROOT:-}
VARIANT_FLAG=""
if [ "$VARIANT" = generic ]; then
    VARIANT_FLAG=" --generic"
    ROOTFS_KEY=GENERIC_ROOTFS
    ROOTFS_OVERRIDE=${HOKUTO_BUILDER_GENERIC_ROOT:-}
    DEFAULT_ROOTFS=/var/lib/hokuto-builder-generic
    MACHINE=$MACHINE-generic
    # A package that fails only as a generic build must not keep the
    # optimized one from being rebuilt, and the other way round.
    BUILD_IGNORE=/var/db/hokuto/build-ignore-generic.json
fi

# Container location: environment, then the location saved by 'create'.
saved_rootfs() {
    # Must succeed without a config file: this runs in an assignment under
    # set -e, where a failing status ends the script silently.
    if [ -f "$CONFIG_FILE" ]; then
        sed -n "s/^$ROOTFS_KEY=//p" "$CONFIG_FILE" | tail -n 1
    fi
}
ROOTFS=${ROOTFS_OVERRIDE:-$(saved_rootfs)}
ROOTFS=${ROOTFS:-$DEFAULT_ROOTFS}

# conf_value <key> <default>: a setting from the config file, the default when
# the file does not set it. An empty value is kept: it removes a limit.
conf_value() {
    if [ -f "$CONFIG_FILE" ] && grep -q "^$1=" "$CONFIG_FILE"; then
        sed -n "s/^$1=//p" "$CONFIG_FILE" | tail -n 1
    else
        printf '%s\n' "$2"
    fi
}
CPU_WEIGHT=$(conf_value CPU_WEIGHT idle)
CPU_QUOTA=$(conf_value CPU_QUOTA "$(($(nproc) * 80))%")
MEMORY_HIGH=$(conf_value MEMORY_HIGH 50%)
[ -z "$CPU_QUOTA" ] || [[ "$CPU_QUOTA" =~ ^[1-9][0-9]*%$ ]] ||
    die "CPU_QUOTA in $CONFIG_FILE must be a percentage such as 1600% (100% per thread), not '$CPU_QUOTA'"
CYCLE_JOBS=$(conf_value CYCLE_JOBS 4)
CYCLE_GENERIC=$(conf_value CYCLE_GENERIC 0)
RUN_LOG_DIR=/var/log/hokuto-builder
RUN_LOG=$RUN_LOG_DIR/runs.log

# The build user: the one who ran sudo; started as root (the service), the
# user saved by 'create', else the one the container's state belongs to.
BUILD_USER=${SUDO_USER:-${HOKUTO_BUILDER_USER:-$(conf_value BUILD_USER "")}}
if [ -z "$BUILD_USER" ] && [ -z "${SUDO_USER:-}" ] && [ -d "$ROOTFS/var/lib/hokuto" ]; then
    BUILD_USER=$(stat -c %U "$ROOTFS/var/lib/hokuto")
fi
if [ -z "$BUILD_USER" ] || [ "$BUILD_USER" = root ] || [ "$BUILD_USER" = UNKNOWN ]; then
    die "run hokuto-builder as your normal user; it uses sudo itself (as root, set HOKUTO_BUILDER_USER or BUILD_USER= in $CONFIG_FILE)"
fi
BUILD_UID=$(id -u "$BUILD_USER")
BUILD_GID=$(id -g "$BUILD_USER")
BUILD_GROUP=$(id -gn "$BUILD_USER")
BUILD_HOME=$(getent passwd "$BUILD_USER" | cut -d: -f6)

# save_conf <key> <value> sets one setting, keeping the others (such as the
# other container's location).
save_conf() {
    local tmp
    tmp=$(mktemp "$CONFIG_FILE.XXXXXX")
    if [ -f "$CONFIG_FILE" ]; then
        grep -v "^$1=" "$CONFIG_FILE" >"$tmp" || true
    fi
    printf '%s=%s\n' "$1" "$2" >>"$tmp"
    chmod 644 "$tmp"
    mv -f "$tmp" "$CONFIG_FILE"
}

container_exists() {
    [ -d "$ROOTFS/var/db/hokuto/installed" ]
}

# Refuse to start while the sources cache is not mounted: downloads would
# silently fill the directory underneath it on the root filesystem.
check_sources_mount() {
    if systemctl cat "$SOURCES_UNIT" >/dev/null 2>&1 && ! mountpoint -q "$SOURCES_MOUNT"; then
        die "$SOURCES_MOUNT is not mounted ($SOURCES_UNIT); unlock and mount GiGA first"
    fi
}

# The container needs a persistent filesystem that allows setuid (sudo).
# /run and /tmp are RAM-backed tmpfs mounted nosuid, so a typo such as
# /run/media/Intel for /run/media/$USER/Intel ends up there.
check_location() {
    local dir=$1 fstype options
    while [ ! -e "$dir" ]; do dir=$(dirname -- "$dir"); done
    fstype=$(findmnt -n -o FSTYPE -T "$dir")
    options=$(findmnt -n -o OPTIONS -T "$dir")
    case "$fstype" in
        tmpfs | ramfs)
            die "$1 would be on $fstype ($(findmnt -n -o TARGET -T "$dir")): it lives in RAM and is lost on reboot"
            ;;
    esac
    case ",$options," in
        *,nosuid,*)
            die "$1 is on a filesystem mounted nosuid ($(findmnt -n -o TARGET -T "$dir")); sudo cannot work in the container. Remount it with 'suid' or pick another location"
            ;;
    esac
}

cmd_create() {
    command -v systemd-nspawn >/dev/null || die "systemd-nspawn not found"
    local answer
    read -r -p "Container location [$ROOTFS]: " answer
    ROOTFS=$(realpath -m -- "${answer:-$ROOTFS}")
    [ "$ROOTFS" != / ] || die "refusing to use / as the container location"
    # The optimized and generic containers must be separate trees.
    local other_key=GENERIC_ROOTFS other
    [ "$VARIANT" = generic ] && other_key=ROOTFS
    other=$(sed -n "s/^$other_key=//p" "$CONFIG_FILE" 2>/dev/null | tail -n 1 || true)
    [ -z "$other" ] || [ "$(realpath -m -- "$other")" != "$ROOTFS" ] ||
        die "$ROOTFS is the other hokuto-builder container; pick another location"
    container_exists && die "$ROOTFS already exists; use 'update', or 'destroy' and create it again"
    # Never install a system on top of existing data.
    if [ -e "$ROOTFS" ] && [ -n "$(ls -A -- "$ROOTFS" 2>/dev/null)" ]; then
        die "$ROOTFS exists and is not empty"
    fi
    check_location "$ROOTFS"
    mkdir -p "$ROOTFS"
    save_conf "$ROOTFS_KEY" "$ROOTFS"
    # The service runs as root and builds as this user.
    save_conf BUILD_USER "$BUILD_USER"
    info "Saved the location in $CONFIG_FILE"

    info "Installing ${BASE_PACKAGES[*]} ($VARIANT) into $ROOTFS"
    # --remote installs binaries from the mirror, so nothing is compiled on
    # the host to create the container. The generic container gets the
    # generic variant of every package: a generic build links static pieces
    # of them (libgcc.a, crt*.o, static libraries) into its output.
    if [ "$VARIANT" = generic ]; then
        HOKUTO_GENERIC=1 HOKUTO_ROOT="$ROOTFS" hokuto install -y --remote "${BASE_PACKAGES[@]}"
    else
        HOKUTO_ROOT="$ROOTFS" hokuto install -y --remote "${BASE_PACKAGES[@]}"
    fi

    info "Creating user $BUILD_USER ($BUILD_UID:$BUILD_GID)"
    if [ -x "$ROOTFS/usr/bin/pwconv" ] || [ -x "$ROOTFS/usr/sbin/pwconv" ]; then
        chroot "$ROOTFS" pwconv
    fi
    chroot "$ROOTFS" getent group "$BUILD_GROUP" >/dev/null ||
        chroot "$ROOTFS" groupadd -g "$BUILD_GID" "$BUILD_GROUP"
    chroot "$ROOTFS" getent passwd "$BUILD_USER" >/dev/null ||
        chroot "$ROOTFS" useradd -M -u "$BUILD_UID" -g "$BUILD_GID" -d "$BUILD_HOME" -s /bin/bash "$BUILD_USER"
    install -d -m 0755 -o "$BUILD_UID" -g "$BUILD_GID" "$ROOTFS$BUILD_HOME"

    # hokuto authenticates through sudo; nobody can log into the container.
    local sudoers="$ROOTFS/etc/sudoers"
    [ -f "$sudoers" ] || die "sudo did not install $sudoers"
    grep -qE '^[@#]includedir[[:space:]]+/etc/sudoers.d' "$sudoers" ||
        printf '\n@includedir /etc/sudoers.d\n' >>"$sudoers"
    install -d -m 0750 "$ROOTFS/etc/sudoers.d"
    printf '%s ALL=(ALL:ALL) NOPASSWD: ALL\n' "$BUILD_USER" >"$ROOTFS/etc/sudoers.d/hokuto-builder"
    chmod 0440 "$ROOTFS/etc/sudoers.d/hokuto-builder"

    if [ -x "$ROOTFS/usr/bin/locale-gen" ]; then
        info "Generating locales from /etc/locale.gen"
        chroot "$ROOTFS" /usr/bin/locale-gen
    fi

    echo "$MACHINE" >"$ROOTFS/etc/hostname"
    info "Container ready: $ROOTFS"
}

# Cross builds run target binaries (meson build tools, spa-json-dump, test
# helpers) through qemu-user-static via binfmt_misc. That registration is host
# kernel state: in the container systemd-binfmt cannot run and
# /proc/sys/fs/binfmt_misc is read only, so the post-install of the
# container's qemu-user-static-binfmt registers nothing and aarch64 binaries
# fail with "Exec format error". Register it from the host instead. The F flag
# makes the kernel open the interpreter at registration, so it works inside the
# container even when the path only exists in the container's root.
ensure_qemu_binfmt() {
    local name=qemu-aarch64 binfmt=/proc/sys/fs/binfmt_misc
    local conf=/usr/lib/binfmt.d/qemu-aarch64-static.conf
    local interp=/usr/bin/qemu-aarch64-static root="" rule
    [ -e "$binfmt/$name" ] && return 0
    if ! mountpoint -q "$binfmt"; then
        mount -t binfmt_misc binfmt_misc "$binfmt" 2>/dev/null || {
            info "binfmt_misc is unavailable; cross builds cannot run aarch64 binaries"
            return 0
        }
        [ -e "$binfmt/$name" ] && return 0
    fi
    if [ ! -f "$conf" ] || [ ! -x "$interp" ]; then
        root=$ROOTFS
        if [ ! -f "$root$conf" ] || [ ! -x "$root$interp" ]; then
            info "Installing qemu-user-static-binfmt into the container for cross builds"
            HOKUTO_ROOT="$ROOTFS" hokuto install -y --remote qemu-user-static-binfmt || {
                info "Could not install qemu-user-static-binfmt; cross builds cannot run aarch64 binaries"
                return 0
            }
        fi
    fi
    rule=$(grep -m1 "^:$name:" "$root$conf") || return 0
    # Fields: :name:type:offset:magic:mask:interpreter:flags
    rule=$(printf '%s\n' "$rule" | awk -F: -v OFS=: -v interp="$root$interp" '
        { $7 = interp; if ($8 !~ /F/) $8 = $8 "F"; print }')
    if printf '%s' "$rule" >"$binfmt/register" 2>/dev/null; then
        info "Registered $name with binfmt_misc for cross builds"
    else
        info "Could not register $name with binfmt_misc; cross builds cannot run aarch64 binaries"
    fi
}

# Both containers share /var/cache/hokuto: one's upload --sync would delete a
# package the other just built and is about to install. Run one at a time.
BUILDER_LOCK=/run/lock/hokuto-builder.lock
EXCLUSIVE=1
acquire_builder_lock() {
    [ "$EXCLUSIVE" = 1 ] || return 0
    exec 9>"$BUILDER_LOCK"
    if ! flock -n 9; then
        info "Another hokuto-builder command is running; waiting for it to finish"
        flock 9
    fi
}

# nspawn_run <user> <command...>
nspawn_run() {
    local user=$1
    shift
    container_exists || die "no container at $ROOTFS; run 'hokuto-builder${VARIANT_FLAG} create' first"
    # Removable drives are remounted nosuid by udisks after a replug.
    check_location "$ROOTFS"
    check_sources_mount
    acquire_builder_lock
    # Only the optimized container cross builds.
    [ "$VARIANT" = generic ] || ensure_qemu_binfmt

    local args=(
        --quiet
        --directory="$ROOTFS"
        --machine="$MACHINE"
        --register=no
        --resolv-conf=copy-host
        --timezone=copy
        # Lets hokuto name hokuto-builder commands in its hints.
        --setenv=HOKUTO_BUILDER=1
        # Explicit, as systemd-nspawn asks for: its future default plus
        # netlink, which ip(8) and some test suites use.
        --restrict-address-families="AF_INET AF_INET6 AF_UNIX AF_NETLINK"
        --bind-ro=/usr/bin/hokuto:/usr/local/bin/hokuto
    )
    # Without a terminal (the service), nspawn's default console gives the
    # container a terminal nothing ever types into, and a question hokuto
    # asks waits forever. Passing stdin through instead lets it read end of
    # input and take its default.
    [ -t 0 ] || args+=(--console=pipe)
    # Limits on the container's scope unit, which holds every process in it.
    [ -n "$CPU_WEIGHT" ] && args+=(--property="CPUWeight=$CPU_WEIGHT")
    [ -n "$CPU_QUOTA" ] && args+=(--property="CPUQuota=$CPU_QUOTA")
    [ -n "$MEMORY_HIGH" ] && args+=(--property="MemoryHigh=$MEMORY_HIGH")
    # A cycle step: hokuto records each package's build result here.
    if [ -n "${HOKUTO_BUILDER_RESULTS:-}" ]; then
        args+=(--bind="$RUN_LOG_DIR" --setenv=HOKUTO_BUILD_RESULTS="$HOKUTO_BUILDER_RESULTS")
    fi
    # Overrides the shared hokuto.conf: generic flags for every build, and the
    # generic variant for every package hokuto installs in this container.
    [ "$VARIANT" = generic ] && args+=(--setenv=HOKUTO_GENERIC=1)
    # Only the host's local hokuto files: the rest of /etc/hokuto belongs to
    # the container's packages, which must be able to update them.
    local file
    for file in hokuto.lock keys mirror-auth; do
        [ -e "/etc/hokuto/$file" ] && args+=(--bind-ro="/etc/hokuto/$file")
    done
    # sauzeros-base ships hokuto.conf and hokuto hokuto.prefer, and an install
    # renames its new copy over the file, which a bind mount refuses (EBUSY).
    # Copied instead, on every run, so the host's settings win over whatever
    # an update put there.
    for file in hokuto.conf hokuto.prefer; do
        if [ -f "/etc/hokuto/$file" ]; then
            install -d "$ROOTFS/etc/hokuto"
            cp --preserve=mode,ownership "/etc/hokuto/$file" "$ROOTFS/etc/hokuto/$file"
        fi
    done
    # hokuto stages installs on the root's own filesystem so it can hard link
    # them into place; /var/cache/hokuto is the host's here, so it uses this
    # one, which the build user must own (hokuto creates entries as that user).
    install -d -o "$BUILD_UID" -g "$BUILD_GID" "$ROOTFS/var/lib/hokuto"
    install -d -o "$BUILD_UID" -g "$BUILD_GID" "$ROOTFS/var/lib/hokuto/staging"
    chown "$BUILD_UID:$BUILD_GID" "$ROOTFS/var/lib/hokuto" "$ROOTFS/var/lib/hokuto/staging"
    # Interactive shells reset PATH in /etc/profile, which appends
    # /usr/local/bin at the end; move it to the front there too.
    install -d "$ROOTFS/etc/profile.d"
    printf '%s\n' '# hokuto-builder: prefer the host hokuto mounted at /usr/local/bin' \
        'case "$PATH" in /usr/local/bin:*) ;; *) PATH="/usr/local/bin:$PATH" ;; esac' \
        'export PATH' >"$ROOTFS/etc/profile.d/hokuto-builder.sh"
    local dir
    for dir in "${SHARED_DIRS[@]}"; do
        [ -d "$dir" ] || install -d -o "$BUILD_UID" -g "$BUILD_GID" "$dir"
        args+=(--bind="$dir")
    done
    # A separate mount below /var/cache/hokuto; bind it explicitly.
    mountpoint -q "$SOURCES_MOUNT" && args+=(--bind="$SOURCES_MOUNT")
    [ "$VARIANT" = optimized ] && [ -f "$BUMP_IGNORE" ] && args+=(--bind="$BUMP_IGNORE")
    # Created on the host when missing, so it can be bound; hokuto overwrites
    # it in place, and a blacklist made in the container lands on the host.
    if [ ! -e "$BUILD_IGNORE" ]; then
        install -d /var/db/hokuto
        printf '[]\n' >"$BUILD_IGNORE"
        chmod 644 "$BUILD_IGNORE"
    fi
    args+=(--bind="$BUILD_IGNORE:$CONTAINER_BUILD_IGNORE")
    if [ ! -e "$NO_BUILD" ]; then
        install -d /var/db/hokuto
        printf '[]\n' >"$NO_BUILD"
        chmod 644 "$NO_BUILD"
    fi
    args+=(--bind="$NO_BUILD")
    # The website's status table has one row per package; generic builds
    # would overwrite the optimized ones' status and logs.
    if [ "$VARIANT" = optimized ]; then
        local website
        website=$(sed -n 's/^HOKUTO_WEBSITE_REPO=//p' /etc/hokuto/hokuto.conf 2>/dev/null | tail -n 1 | tr -d '"' || true)
        website=${website:-$DEFAULT_WEBSITE_REPO}
        if [ -d "$website/.git" ]; then
            args+=(--bind="$website")
        else
            info "No website checkout at $website; build status will not be published"
        fi
    fi
    for file in .gitconfig .git-credentials; do
        [ -f "$BUILD_HOME/$file" ] && args+=(--bind-ro="$BUILD_HOME/$file")
    done

    if [ "$user" = root ]; then
        systemd-nspawn "${args[@]}" -- "$@"
    else
        systemd-nspawn "${args[@]}" --uid="$user" --chdir="$BUILD_HOME" \
            --setenv=HOME="$BUILD_HOME" -- "$@"
    fi
}

# Shell functions put in front of the scripts below, which run in the
# container. hokuto removes the build dependencies it installs, but a
# dependency cycle can keep a whole tree installed (solid needs qt, which
# needs gtk+3, ...), and that tree then changes what later builds link
# against. So each command records the installed packages before its work
# starts and removes whatever is new once everything, upload included, is
# done. hokuto uninstall still refuses to remove a package that one recorded
# before needs, e.g. a new dependency of a package that was updated.
# shellcheck disable=SC2016
LEFTOVER_FUNCS='
installed_before=/tmp/hokuto-builder-installed.before
snapshot_installed() {
    ls -1 /var/db/hokuto/installed >"$installed_before"
}
# In hokuto colors, on a terminal: #FFEB3B arrow, #1976D2 text, #0ba913 names.
leftover_note() {
    if [ -t 1 ]; then
        printf "\033[38;2;255;235;59m->\033[0m \033[38;2;25;118;210m%s\033[0m \033[38;2;11;169;19m%s\033[0m\n" "$1" "$2"
    else
        printf -- "-> %s %s\n" "$1" "$2"
    fi
}
leftover_warn() {
    if [ -t 1 ]; then
        printf "\033[38;2;255;235;59m->\033[0m \033[1;33m%s\033[0m\n" "$1"
    else
        printf -- "-> %s\n" "$1"
    fi
}
remove_leftovers() {
    [ -f "$installed_before" ] || return 0
    leftovers=$(ls -1 /var/db/hokuto/installed | grep -vxF -f "$installed_before" || true)
    rm -f "$installed_before"
    [ -n "$leftovers" ] || return 0
    leftover_note "Removing packages this run left installed:" "$(echo $leftovers)"
    # shellcheck disable=SC2086
    /usr/local/bin/hokuto uninstall -y $leftovers ||
        leftover_warn "Some packages could not be removed; check with hokuto-builder run hokuto list"
}
'

# The build step of `hokuto bump --build` for packages that are already
# bumped (e.g. after a failed build): not installed, status and log
# published to the website, then the mirror synced if the build succeeded.
cmd_build() {
    local upload=1 arg
    local args=()
    for arg in "$@"; do
        if [ "$arg" = --no-upload ]; then
            upload=0
        else
            args+=("$arg")
        fi
    done
    [ ${#args[@]} -gt 0 ] || die "usage: hokuto-builder${VARIANT_FLAG} build <pkg>... [--no-upload]"
    # Build status goes to the website from the optimized container only.
    local build_flags=(--no-install)
    [ "$VARIANT" = optimized ] && build_flags+=(--index)
    # One container session; the arguments reach hokuto as "$@", unquoted
    # nowhere.
    # shellcheck disable=SC2016
    nspawn_run "$BUILD_USER" /bin/sh -c "$LEFTOVER_FUNCS"'
        upload=$1
        shift
        snapshot_installed
        status=0
        /usr/local/bin/hokuto build "$@" || status=$?
        # A failed package must not keep the others off the mirror: upload
        # whatever was built, then report the build status.
        if [ "$upload" = 1 ]; then
            /usr/local/bin/hokuto upload --sync || { rc=$?; [ "$status" != 0 ] || status=$rc; }
        fi
        remove_leftovers
        exit "$status"
    ' hokuto-builder-build "$upload" "${build_flags[@]}" "${args[@]}"
}

# A library whose new version drops a soname makes bump raise the revision of
# the published packages linked against it. Build those: first update the
# container from the mirror (binary packages only), so they link against the
# library bump just uploaded, then build every recipe whose current version
# has no package yet, as hokuto update --build-missing-binaries lists them,
# and upload.
cmd_rebuild() {
    local upload=1 arg
    local args=()
    for arg in "$@"; do
        if [ "$arg" = --no-upload ]; then
            upload=0
        else
            args+=("$arg")
        fi
    done
    # Build status goes to the website from the optimized container only,
    # as with build.
    local rebuild_flags=()
    [ "$VARIANT" = optimized ] && rebuild_flags+=(--index)
    # shellcheck disable=SC2016
    nspawn_run "$BUILD_USER" /bin/sh -c "$LEFTOVER_FUNCS"'
        upload=$1
        shift
        /usr/local/bin/hokuto update --remote -y || exit
        # After the update: what it installed stays in the container.
        snapshot_installed
        status=0
        /usr/local/bin/hokuto update --build-missing-binaries "$@" || status=$?
        # A failed package must not keep the others off the mirror: upload
        # whatever was built, then report the build status.
        if [ "$upload" = 1 ]; then
            /usr/local/bin/hokuto upload --sync || { rc=$?; [ "$status" != 0 ] || status=$rc; }
        fi
        remove_leftovers
        exit "$status"
    ' hokuto-builder-rebuild "$upload" "${rebuild_flags[@]}" "${args[@]}"
}

# hokuto cross-sync: build the native aarch64 packages, or with -system the
# aarch64-* cross-system packages, that the mirror lacks at their recipe
# version. Both are found from the mirror index and the recipes, so nothing
# needs to be installed first. The mirror is synced afterwards. Like build, it never installs what it builds: the
# packages are for the mirror, not this container.
cmd_cross_sync() {
    local upload=1 arg
    local args=(-no-install)
    for arg in "$@"; do
        if [ "$arg" = --no-upload ]; then
            upload=0
        else
            args+=("$arg")
        fi
    done
    # shellcheck disable=SC2016
    nspawn_run "$BUILD_USER" /bin/sh -c "$LEFTOVER_FUNCS"'
        upload=$1
        shift
        snapshot_installed
        status=0
        /usr/local/bin/hokuto cross-sync "$@" || status=$?
        # A failed package must not keep the others off the mirror: upload
        # whatever was built, then report the build status.
        if [ "$upload" = 1 ]; then
            /usr/local/bin/hokuto upload --sync || { rc=$?; [ "$status" != 0 ] || status=$rc; }
        fi
        remove_leftovers
        exit "$status"
    ' hokuto-builder-cross-sync "$upload" "${args[@]}"
}

# A held python minor upgrade (hokuto python-rebuild). --check runs in an
# overlay of the container: the new python and the build tools it installs
# land in a scratch upper layer, removed afterwards, so a check that fails
# leaves the container as it was. The other options run in the container.
cmd_python_rebuild() {
    local sub=status arg
    local args=()
    for arg in "$@"; do
        case "$arg" in
            --check) sub=check ;;
            --confirm) sub=confirm ;;
            --status) sub=status ;;
            --list) sub=list ;;
            --cancel) sub=cancel ;;
            *) args+=("$arg") ;;
        esac
    done
    case "$sub" in
        check) python_rebuild_check "${args[@]}" ;;
        status | list)
            EXCLUSIVE=0 nspawn_run "$BUILD_USER" /usr/local/bin/hokuto python-rebuild "$sub" "${args[@]}"
            ;;
        *) nspawn_run "$BUILD_USER" /usr/local/bin/hokuto python-rebuild "$sub" "${args[@]}" ;;
    esac
}

PYTHON_CHECK_DIR=""
python_check_cleanup() {
    [ -n "$PYTHON_CHECK_DIR" ] || return 0
    if mountpoint -q "$PYTHON_CHECK_DIR/merged"; then
        umount "$PYTHON_CHECK_DIR/merged" || umount -l "$PYTHON_CHECK_DIR/merged" || true
    fi
    rm -rf "$PYTHON_CHECK_DIR"
}

python_rebuild_check() {
    container_exists || die "no container at $ROOTFS; run 'hokuto-builder create' first"
    PYTHON_CHECK_DIR="$ROOTFS.python-rebuild"
    # Left by a check that was killed.
    python_check_cleanup
    PYTHON_CHECK_DIR="$ROOTFS.python-rebuild"
    trap python_check_cleanup EXIT
    install -d "$PYTHON_CHECK_DIR/upper" "$PYTHON_CHECK_DIR/work" "$PYTHON_CHECK_DIR/merged"
    mount -t overlay overlay \
        -o "lowerdir=$ROOTFS,upperdir=$PYTHON_CHECK_DIR/upper,workdir=$PYTHON_CHECK_DIR/work" \
        "$PYTHON_CHECK_DIR/merged" || die "failed to mount the overlay for the check"
    info "Checking in a throwaway overlay of the container; nothing it installs stays"
    local rootfs=$ROOTFS status=0
    ROOTFS="$PYTHON_CHECK_DIR/merged"
    nspawn_run "$BUILD_USER" /usr/local/bin/hokuto python-rebuild check "$@" || status=$?
    ROOTFS=$rootfs
    python_check_cleanup
    trap - EXIT
    return "$status"
}

# fmt_duration <seconds>
fmt_duration() {
    local s=$1
    if [ "$s" -ge 3600 ]; then
        printf '%dh%02dm' $((s / 3600)) $((s % 3600 / 60))
    elif [ "$s" -ge 60 ]; then
        printf '%dm%02ds' $((s / 60)) $((s % 60))
    else
        printf '%ds' "$s"
    fi
}

# cycle_step <summary> <label> <hokuto-builder arguments...>: one step of a
# cycle, in its own hokuto-builder process so a failure does not end the
# cycle. Its status and the packages it built go to the summary file and, for
# the website, to ROUND_FILE (see hokuto website-round); CYCLE_ACTIVE is set
# when it built something or failed.
CYCLE_ACTIVE=0
ROUND_FILE=""
cycle_step() {
    local summary=$1 label=$2
    shift 2
    local results start rc=0 elapsed status
    results=$(mktemp "$RUN_LOG_DIR/results.XXXXXX")
    # Written by hokuto in the container, as the build user.
    chown "$BUILD_UID:$BUILD_GID" "$results"
    info "Cycle: $label"
    start=$(date +%s)
    HOKUTO_BUILDER_USER=$BUILD_USER HOKUTO_BUILDER_RESULTS=$results \
        "$(readlink -f "$0")" "$@" </dev/null 8>&- || rc=$?
    elapsed=$(($(date +%s) - start))
    status=ok
    [ "$rc" = 0 ] || status="FAILED (exit $rc)"
    { [ "$rc" = 0 ] && [ ! -s "$results" ]; } || CYCLE_ACTIVE=1
    {
        printf 'step\t%s\t%s\t%s\n' "$label" "$rc" "$elapsed"
        sed 's/^/pkg\t/' "$results"
    } >>"$ROUND_FILE"
    {
        printf '  %-20s %-18s %s\n' "$label" "$status" "$(fmt_duration "$elapsed")"
        if [ -s "$results" ]; then
            local when result pkg version arch secs reason
            while IFS=$'\t' read -r when result pkg version arch secs reason; do
                case "$result" in
                    success)
                        printf '      built        %s %s (%s, %s)\n' "$pkg" "$version" "$arch" "$(fmt_duration "$secs")" ;;
                    blacklisted)
                        printf '      BLACKLISTED  %s %s (%s): %s\n' "$pkg" "$version" "$arch" "$reason" ;;
                    nomatch)
                        printf '      NO MATCH     %s %s: %s\n' "$pkg" "$version" "$reason" ;;
                    *)
                        printf '      FAILED       %s %s (%s, %s): %s\n' "$pkg" "$version" "$arch" "$(fmt_duration "$secs")" "$reason" ;;
                esac
            done <"$results"
        else
            printf '      nothing built\n'
        fi
    } >>"$summary"
    # Before the next step: what this one's failed builds left.
    clean_tmpdirs
    # Entries kept for a running build alone do not make the round worth
    # reporting.
    case "$CLEANED" in
        "removed 0 "*) ;;
        *)
            printf '      tmpdir cleanup: %s\n' "$CLEANED" >>"$summary"
            CYCLE_ACTIVE=1
            ;;
    esac
    rm -f "$results"
}

# in_use <path>: whether a process works inside path (its current
# directory), as every process of a running build does, on the host or in a
# container (the tmpdirs are bound at the same path).
in_use() {
    local link cwd
    for link in /proc/[0-9]*/cwd; do
        cwd=$(readlink "$link" 2>/dev/null) || continue
        case "$cwd" in
            "$1" | "$1"/*) return 0 ;;
        esac
    done
    return 1
}

# clean_tmpdirs: remove what failed builds left in the build tmpdirs (a
# successful build removes its own tree), so they cannot fill them for the
# steps after. An entry a running build works in, on the host or in a
# container, is kept: the tmpdirs are shared. Sets CLEANED to what it did,
# and adds to the round's CLEANED_TOTAL and CLEAN_KEPT.
CLEANED=""
CLEANED_TOTAL=0
CLEAN_KEPT=0
clean_tmpdirs() {
    local dir entry n=0 kept=0
    for dir in "${TMP_DIRS[@]}"; do
        [ -d "$dir" ] || continue
        for entry in "$dir"/* "$dir"/.[!.]* "$dir"/..?*; do
            [ -e "$entry" ] || [ -L "$entry" ] || continue
            if in_use "$entry"; then
                kept=$((kept + 1))
                continue
            fi
            rm -rf --one-file-system -- "$entry"
            n=$((n + 1))
        done
    done
    CLEANED_TOTAL=$((CLEANED_TOTAL + n))
    CLEAN_KEPT=$((CLEAN_KEPT + kept))
    CLEANED="removed $n leftover item(s)"
    [ "$kept" = 0 ] || CLEANED+=", kept $kept in use by a running build"
}

# publish_round <start>: the round on the website's rounds.html, committed and
# pushed by the host's hokuto as the build user, who owns the website checkout
# and the git credentials. A failure only costs the round its entry.
publish_round() {
    printf 'round\t%s\t%s\n' "$1" $(($(date +%s) - $1)) >>"$ROUND_FILE"
    chown "$BUILD_UID:$BUILD_GID" "$ROUND_FILE"
    runuser -u "$BUILD_USER" -- env HOME="$BUILD_HOME" hokuto website-round "$ROUND_FILE" 8>&- ||
        info "Could not publish the round to the website"
}

CYCLE_LOCK=/run/lock/hokuto-builder-cycle.lock

# remove_round_files: a round's temporary files in the run log directory
# (summary, round record, package results), which only the round that holds
# CYCLE_LOCK can own.
remove_round_files() {
    find "$RUN_LOG_DIR" -maxdepth 1 -type f \( -name 'cycle.*' -o -name 'round.*' -o -name 'results.*' \) -delete
}

# generic_rootfs: the generic container's location, as the --generic
# commands find it.
generic_rootfs() {
    local root=${HOKUTO_BUILDER_GENERIC_ROOT:-}
    [ -n "$root" ] || root=$(conf_value GENERIC_ROOTFS "")
    printf '%s\n' "${root:-/var/lib/hokuto-builder-generic}"
}

# check_cycle_setup fails the round, and so the service, when a container it
# needs is missing: a round of steps that all fail at once would only bury
# the cause in the log.
check_cycle_setup() {
    container_exists ||
        die "missing container at $ROOTFS: set it up first with 'hokuto-builder create' (or mount its drive)"
    case "$CYCLE_GENERIC" in
        0) ;;
        1)
            local generic
            generic=$(generic_rootfs)
            [ -d "$generic/var/db/hokuto/installed" ] ||
                die "missing generic container at $generic: set it up first with 'hokuto-builder --generic create', or set CYCLE_GENERIC=0 in $CONFIG_FILE"
            ;;
        *) die "CYCLE_GENERIC in $CONFIG_FILE must be 0 or 1, not '$CYCLE_GENERIC'" ;;
    esac
    [[ "$CYCLE_JOBS" =~ ^[1-9][0-9]*$ ]] ||
        die "CYCLE_JOBS in $CONFIG_FILE must be a positive number, not '$CYCLE_JOBS'"
}

# One unattended round, for hokuto-builder.service: auto-bump and build, the
# rebuilds bump left, then the cross-system and native aarch64 packages the
# mirror lacks, cleaning the build tmpdirs before each step and at the end.
# Package status and logs also go to the website (packages.html) as with the
# interactive commands; the run log keeps the rounds, and those that did
# something also go to the website's rounds.html. Failed packages do not fail
# the round.
cmd_cycle() {
    check_cycle_setup
    install -d -m 0755 "$RUN_LOG_DIR"
    # One round at a time, so the temporary files of the run log directory
    # left here are a killed round's, never a running one's.
    exec 8>"$CYCLE_LOCK"
    flock -n 8 || die "another hokuto-builder cycle is running"
    remove_round_files
    trap remove_round_files EXIT
    # systemctl stop sends TERM; exit so the EXIT trap runs.
    trap 'exit 143' TERM INT
    local summary start
    summary=$(mktemp "$RUN_LOG_DIR/cycle.XXXXXX")
    ROUND_FILE=$(mktemp "$RUN_LOG_DIR/round.XXXXXX")
    start=$(date +%s)
    # What an interrupted round left.
    clean_tmpdirs
    case "$CLEANED" in
        "removed 0 "*) ;;
        *)
            printf '  %-20s %s\n' "tmpdir cleanup" "$CLEANED" >>"$summary"
            CYCLE_ACTIVE=1
            ;;
    esac
    cycle_step "$summary" bump bump -y "-j$CYCLE_JOBS"
    # What bump's ABI check revision-bumped, and earlier failures whose
    # recipe has changed since (blacklisted ones stay skipped). -y builds
    # only packages that have been published before.
    cycle_step "$summary" rebuild rebuild -y "-j$CYCLE_JOBS"
    # The same for the generic packages, bumped ones included.
    if [ "$CYCLE_GENERIC" = 1 ]; then
        cycle_step "$summary" "generic rebuild" --generic rebuild -y "-j$CYCLE_JOBS"
    fi
    cycle_step "$summary" "cross-sync -system" cross-sync -system -y "-j$CYCLE_JOBS"
    cycle_step "$summary" cross-sync cross-sync -y "-j$CYCLE_JOBS"
    local cleaned="removed $CLEANED_TOTAL leftover item(s)"
    [ "$CLEAN_KEPT" = 0 ] || cleaned+=", kept $CLEAN_KEPT in use by a running build"
    printf 'cleanup\t%s\n' "$cleaned" >>"$ROUND_FILE"
    local header
    header="$(date -d "@$start" '+%Y-%m-%d %H:%M'), $(fmt_duration $(($(date +%s) - start)))"
    # A round runs every 15 minutes: one with nothing to report takes a line.
    if [ "$CYCLE_ACTIVE" = 0 ]; then
        printf '== %s: nothing to do ==\n' "$header" | tee -a "$RUN_LOG"
    else
        {
            printf '== %s ==\n' "$header"
            cat "$summary"
            echo
        } | tee -a "$RUN_LOG"
        publish_round "$start"
    fi
}

cmd_destroy() {
    [ "$ROOTFS" != / ] || die "refusing to delete /"
    container_exists || [ -d "$ROOTFS" ] || die "no container at $ROOTFS"
    if pgrep -f "systemd-nspawn.*--directory=$ROOTFS" >/dev/null; then
        die "the container is running"
    fi
    read -r -p "Delete $ROOTFS? [y/N] " answer
    [[ "$answer" =~ ^[Yy]$ ]] || exit 1
    # Bind mounts only exist inside a running container, and
    # --one-file-system stops at anything else mounted below the root.
    rm -rf --one-file-system -- "$ROOTFS"
    info "Deleted $ROOTFS"
}

case "$1" in
    create) cmd_create ;;
    bump)
        shift
        # shellcheck disable=SC2016
        nspawn_run "$BUILD_USER" /bin/sh -c "$LEFTOVER_FUNCS"'
            snapshot_installed
            status=0
            /usr/local/bin/hokuto bump --auto --build "$@" || status=$?
            remove_leftovers
            exit "$status"
        ' hokuto-builder-bump "$@"
        ;;
    build) shift; cmd_build "$@" ;;
    rebuild) shift; cmd_rebuild "$@" ;;
    cross-sync) shift; cmd_cross_sync "$@" ;;
    cycle) cmd_cycle ;;
    # Each container keeps its own blacklist; this one does not wait for a
    # running round.
    blacklist) shift; EXCLUSIVE=0 nspawn_run "$BUILD_USER" /usr/local/bin/hokuto blacklist "$@" ;;
    # The list is a host file, bound into both containers: the host's hokuto
    # edits it directly, so this needs no container and works during a round.
    nobuild) shift; exec /usr/bin/hokuto nobuild "$@" ;;
    python-rebuild) shift; cmd_python_rebuild "$@" ;;
    run) shift; [ $# -gt 0 ] || usage 1; nspawn_run "$BUILD_USER" "$@" ;;
    shell) EXCLUSIVE=0 nspawn_run "$BUILD_USER" /bin/bash -l ;;
    update) nspawn_run "$BUILD_USER" /usr/local/bin/hokuto update -y ;;
    destroy) cmd_destroy ;;
esac
